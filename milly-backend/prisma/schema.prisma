generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Ticket {
  id          Int     @id @default(autoincrement())
  title       String
  status      String
  description String? @db.Text
  owner       Int?
  asignee     Int?
  board       Board   @relation(fields: [boardId], references: [id])
  boardId     Int
}

model Board {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  owner       Int      @default(0)
  tickets     Ticket[]
}
