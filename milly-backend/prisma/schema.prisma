generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Ticket {
  id          Int       @id @default(autoincrement())
  title       String
  description String?   @db.Text
  owner       Int?
  asignee     Int?
  board       Board     @relation(fields: [boardId], references: [id])
  boardId     Int
  comments    Comment[]
  columnId    Int
  column      Column    @relation(fields: [columnId], references: [id])
}

model Board {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  owner       Int      @default(0)
  tickets     Ticket[]
  columns     Column[]
}

model Comment {
  id       Int    @id @default(autoincrement())
  content  String
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])
}

model Column {
  id       Int      @id @default(autoincrement())
  name     String
  position Int
  boardId  Int
  board    Board    @relation(fields: [boardId], references: [id])
  tickets  Ticket[]
}
